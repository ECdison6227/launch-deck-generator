    "motion": "12.23.24",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "sonner": "2.0.8",
    "swiper": "14.3.0",
    "three": "^0.186.1",
    "tw-animate-css": "1.4.0",
    "vanta": "^0.5.24"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
